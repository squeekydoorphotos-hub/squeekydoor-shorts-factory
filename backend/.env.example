# ── REQUIRED ──────────────────────────────────────────────────────
# Make this a random 32-character string (anything works)
SECRET_KEY=change-me-to-something-random-32chars

# Your Claude API key from console.anthropic.com
CLAUDE_API_KEY=sk-ant-...

# Your frontend URL (fill in after Netlify deploy)
FRONTEND_URL=https://shorts.squeekydoorproductions.com

# ── STRIPE (get from dashboard.stripe.com) ────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_STUDIO=price_...

# ── PAYPAL (get from developer.paypal.com) ────────────────────────
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...
PAYPAL_MODE=sandbox
